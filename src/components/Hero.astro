---
import evento from '../data/evento.json';
import { ruta } from '../lib/rutas';

const ciudad = evento.direccion.split(',').slice(-2).join(',').trim();
---

<header class="relative flex min-h-[100svh] w-full flex-col justify-between overflow-hidden bg-hueso">
  <!-- Capa de video de fondo a pantalla completa con parallax sutil -->
  <div
    class="pointer-events-none absolute -inset-y-[6%] inset-x-0 h-[112%] w-full overflow-hidden"
    data-parallax
  >
    <video
      data-hero-video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster={ruta('img/hero-poster.webp')}
      class="h-full w-full object-cover object-[58%_center] md:object-center"
    >
      <source src={ruta('img/bebe-limon-hero.webm')} type="video/webm" />
      <source src={ruta('img/bebe-limon-hero.mp4')} type="video/mp4" />
      <img
        src={ruta('img/hero-poster.jpg')}
        alt="Ilustración del bebé limón y cochecito"
        class="h-full w-full object-cover object-[58%_center] md:object-center"
      />
    </video>

    <!-- Capas de integración para que el video forme parte orgánica del diseño -->
    <!-- 1. Tonalidad ambiente acuarela -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-hueso/20 via-transparent to-hueso/25 mix-blend-multiply"
      aria-hidden="true"
    >
    </div>

    <!-- 2. Gradiente inferior para fundir el video sutilmente con la sección siguiente -->
    <div
      class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-hueso via-hueso/50 to-transparent sm:h-36"
      aria-hidden="true"
    >
    </div>

    <!-- 3. Veladura lateral en desktop para contraste natural de la tarjeta sobre las ramas -->
    <div
      class="absolute inset-y-0 left-0 hidden w-[46%] bg-gradient-to-r from-hueso/55 via-hueso/25 to-transparent md:block"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Contenedor de la tarjeta de invitación sobrepuesta -->
  <div
    class="relative z-20 flex flex-1 items-start px-4 pt-6 pb-2 sm:items-center sm:px-8 sm:py-10 md:py-14"
  >
    <div
      class="relative mx-auto w-full max-w-[26rem] rounded-2xl border border-white/80 bg-crema/90 p-5 shadow-[0_20px_50px_-20px_rgba(46,66,87,0.28)] backdrop-blur-md transition-all duration-300 sm:max-w-[27rem] sm:rounded-3xl sm:bg-crema/85 sm:p-8 md:mx-0 md:ml-[5vw] lg:ml-[7vw]"
      data-hero-card
    >
      <p class="rotulo text-salvia" data-hero-item>Nos daría mucho gusto que vinieras al</p>

      <h1 class="mt-3.5 sm:mt-5" data-hero-item>
        <span class="titulo block text-[2.1rem] leading-[0.95] text-tinta sm:text-5xl lg:text-6xl">
          {evento.tipo}
        </span>
        {
          evento.bebe && (
            <span class="mt-2 block font-display text-[1.5rem] italic text-rosa sm:text-4xl">
              de {evento.bebe}
            </span>
          )
        }
      </h1>

      <div class="my-4 h-px w-12 bg-rosa/60 sm:my-5 sm:w-16" data-hero-item></div>

      <p
        class="max-w-lectura font-display text-sm leading-relaxed text-tinta/85 sm:text-base lg:text-lg"
        data-hero-item
      >
        {evento.frase}
      </p>

      <dl class="mt-5 space-y-2.5 text-xs sm:mt-6 sm:space-y-3 sm:text-sm" data-hero-item>
        <div>
          <dt class="rotulo text-salvia">Cuándo</dt>
          <dd class="mt-0.5 font-cuerpo font-light text-tinta sm:mt-1">
            {evento.fechaTexto} · {evento.hora}
          </dd>
        </div>
        <div>
          <dt class="rotulo text-salvia">Dónde</dt>
          <dd class="mt-0.5 font-cuerpo font-light text-tinta sm:mt-1">
            {evento.lugar} <span class="text-tinta/55">· {ciudad}</span>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Indicador inferior para explorar el resto de la invitación -->
  <div class="relative z-20 pb-4 text-center sm:pb-5">
    <a
      href="#detalles"
      class="group inline-flex flex-col items-center text-tinta/55 transition hover:text-tinta"
      data-hero-item
    >
      <span class="rotulo text-[0.62rem] tracking-anchísimo sm:text-[0.68rem]">Ver detalles</span>
      <svg
        viewBox="0 0 24 24"
        class="mt-1 h-3.5 w-3.5 animate-bounce text-tinta/50 transition-transform group-hover:scale-110 sm:mt-1.5 sm:h-4 sm:w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</header>
