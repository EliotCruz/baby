---
import evento from '../data/evento.json';
import { ruta } from '../lib/rutas';

const ciudad = evento.direccion.split(',').slice(-2).join(',').trim();
---

<header class="relative flex min-h-[100svh] w-full flex-col justify-between overflow-hidden bg-hueso">
  <!-- Capa de video de fondo con fuentes responsivas optimizadas -->
  <div
    class="pointer-events-none absolute -inset-y-[6%] inset-x-0 h-[112%] w-full overflow-hidden"
    data-parallax
  >
    <video
      data-hero-video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster={ruta('img/hero-poster.webp')}
      class="h-full w-full object-cover object-center"
    >
      <!-- Móvil (< 768px): video vertical 9:16 nativo (~1.2MB, ultra ligero) -->
      <source media="(max-width: 767px)" src={ruta('img/bebe-limon-hero-mobile.webm')} type="video/webm" />
      <source media="(max-width: 767px)" src={ruta('img/bebe-limon-hero-mobile.mp4')} type="video/mp4" />

      <!-- Desktop (>= 768px): video horizontal 16:9 1080p optimizado -->
      <source media="(min-width: 768px)" src={ruta('img/bebe-limon-hero.webm')} type="video/webm" />
      <source media="(min-width: 768px)" src={ruta('img/bebe-limon-hero.mp4')} type="video/mp4" />

      <!-- Fallback universal -->
      <source src={ruta('img/bebe-limon-hero.mp4')} type="video/mp4" />
      <source src={ruta('img/bebe-limon-hero.webm')} type="video/webm" />

      <img
        src={ruta('img/hero-poster.jpg')}
        alt="Ilustración del bebé limón y cochecito"
        class="h-full w-full object-cover object-center"
      />
    </video>

    <!-- Capas de integración cromática y atmosférica -->
    <!-- 1. Tonalidad ambiente acuarela con fusión suave -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-hueso/20 via-transparent to-hueso/25 mix-blend-multiply"
      aria-hidden="true"
    >
    </div>

    <!-- 2. Gradiente inferior para fundir el video con la sección de la cuenta regresiva -->
    <div
      class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-hueso via-hueso/50 to-transparent sm:h-36"
      aria-hidden="true"
    >
    </div>

    <!-- 3. Veladura lateral en desktop para contraste de la tarjeta sobre las ramas -->
    <div
      class="absolute inset-y-0 left-0 hidden w-[46%] bg-gradient-to-r from-hueso/55 via-hueso/25 to-transparent md:block"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- 1. TÍTULO FLOTANTE HASTA ARRIBA (SIN CARD) -->
  <div class="relative z-20 w-full px-5 pt-8 text-center sm:pt-11 md:ml-[6vw] md:max-w-[30rem] md:pt-14 md:text-left lg:ml-[8vw]">
    <p
      class="rotulo font-medium tracking-anchísimo text-salvia drop-shadow-[0_1px_2px_rgba(255,255,255,0.95)]"
      data-hero-title-item
    >
      Nos daría mucho gusto que vinieras al
    </p>

    <h1 class="mt-1.5 sm:mt-2.5" data-hero-title-item>
      <span class="titulo block text-[2.35rem] leading-[0.92] text-tinta drop-shadow-[0_2px_6px_rgba(255,255,255,0.95)] xs:text-5xl sm:text-6xl lg:text-[4rem]">
        {evento.tipo}
      </span>
      {
        evento.bebe && (
          <span class="mt-1 block font-display text-[1.6rem] italic text-rosa drop-shadow-[0_2px_4px_rgba(255,255,255,0.9)] sm:text-4xl">
            de {evento.bebe}
          </span>
        )
      }
    </h1>
  </div>

  <!-- 2. TARJETA INFORMATIVA QUE APARECE DINÁMICAMENTE AL SEGUNDO 7 -->
  <div
    class="relative z-20 flex flex-1 items-start justify-center px-4 pt-3 pb-2 sm:items-center sm:px-8 sm:py-6 md:items-start md:justify-start md:ml-[6vw] md:pt-3 lg:ml-[8vw]"
  >
    <div
      class="relative w-full max-w-[24.5rem] rounded-2xl border border-white/90 bg-[#FAF7F2]/92 p-5 shadow-[0_20px_50px_-15px_rgba(46,66,87,0.22),0_1px_0_1px_rgba(255,255,255,0.9)_inset] backdrop-blur-md transition-all duration-300 sm:max-w-[27rem] sm:rounded-3xl sm:p-7 md:max-w-[28rem]"
      data-hero-info-card
    >
      <!-- Frase del evento -->
      <p
        class="max-w-lectura font-display text-[1.02rem] italic leading-snug text-tinta/85 sm:text-base sm:leading-relaxed lg:text-lg"
        data-hero-card-item
      >
        {evento.frase}
      </p>

      <!-- Línea divisoria dinámica con gradiente -->
      <div
        class="my-3.5 h-0.5 w-14 rounded-full bg-gradient-to-r from-rosa to-rosa/20 sm:my-4 sm:w-16"
        data-hero-card-line
      >
      </div>

      <!-- Datos clave del evento -->
      <dl class="space-y-3 text-xs sm:space-y-3.5 sm:text-sm">
        <!-- Cuándo -->
        <div class="flex items-start gap-2.5 sm:gap-3" data-hero-card-item>
          <span
            class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-salvia/15 text-salvia sm:h-7 sm:w-7"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" class="h-3 w-3 sm:h-3.5 sm:w-3.5" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </span>
          <div class="min-w-0 flex-1">
            <dt class="rotulo text-[0.6rem] text-salvia sm:text-xs">Cuándo</dt>
            <dd class="mt-0.5 font-cuerpo text-tinta">
              <span class="font-normal text-tinta">{evento.fechaTexto}</span>
              <span class="font-light text-tinta/60"> · {evento.hora}</span>
            </dd>
          </div>
        </div>

        <!-- Dónde -->
        <div class="flex items-start gap-2.5 sm:gap-3" data-hero-card-item>
          <span
            class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-azul/45 text-tinta/80 sm:h-7 sm:w-7"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" class="h-3 w-3 sm:h-3.5 sm:w-3.5" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 21s-8-7.5-8-12a8 8 0 1 1 16 0c0 4.5-8 12-8 12z"></path>
              <circle cx="12" cy="9" r="2.5"></circle>
            </svg>
          </span>
          <div class="min-w-0 flex-1">
            <dt class="rotulo text-[0.6rem] text-salvia sm:text-xs">Dónde</dt>
            <dd class="mt-0.5 font-cuerpo text-tinta">
              <a
                href={evento.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group/loc inline-flex items-baseline gap-1 transition hover:text-rosa"
                title="Abrir ubicación en Google Maps"
              >
                <span class="font-normal text-tinta transition group-hover/loc:text-rosa">{evento.lugar}</span>
                <span class="font-light text-tinta/60">· {ciudad}</span>
                <svg viewBox="0 0 12 12" class="inline h-2.5 w-2.5 opacity-40 transition group-hover/loc:translate-x-0.5 group-hover/loc:opacity-100" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3 9L9 3M9 3H4M9 3V8"></path>
                </svg>
              </a>
            </dd>
          </div>
        </div>
      </dl>
    </div>
  </div>

  <!-- 3. Indicador inferior para explorar el resto de la invitación -->
  <div class="relative z-20 pb-3 text-center sm:pb-5">
    <a
      href="#detalles"
      class="group inline-flex flex-col items-center text-tinta/55 transition hover:text-tinta"
      data-hero-scroll
      aria-label="Desplazarse a los detalles del evento"
    >
      <span class="rotulo text-[0.6rem] tracking-anchísimo sm:text-[0.68rem]">Ver detalles</span>
      <svg
        viewBox="0 0 24 24"
        class="mt-1 h-3.5 w-3.5 animate-bounce text-tinta/50 transition-transform group-hover:scale-110 sm:mt-1.5 sm:h-4 sm:w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</header>
