---
import evento from '../data/evento.json';
import { ruta } from '../lib/rutas';

const ciudad = evento.direccion.split(',').slice(-2).join(',').trim();
---

<header class="relative flex min-h-[100svh] flex-col bg-hueso md:block md:overflow-hidden">
  <!-- Ilustración: banda superior en móvil, fondo completo en desktop -->
  <div
    class="relative h-[44svh] shrink-0 overflow-hidden md:absolute md:inset-0 md:h-auto"
    data-parallax
  >
    <picture>
      <source media="(min-width: 768px)" type="image/webp" srcset={ruta('img/escena-wide.webp')} />
      <source media="(min-width: 768px)" srcset={ruta('img/escena-wide.jpg')} />
      <source type="image/webp" srcset={ruta('img/escena-portrait.webp')} />
      <img
        src={ruta('img/escena-portrait.jpg')}
        alt="Ilustración de un limón sonriente rodeado de margaritas y gypsophila dentro de una taza azul"
        class="h-full w-full object-cover object-[52%_20%] md:h-[112%] md:object-center"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div
      class="absolute inset-0 hidden bg-gradient-to-b from-hueso/5 via-transparent to-hueso/85 md:block"
    >
    </div>
  </div>

  <!-- Tarjeta de la invitación -->
  <div
    class="relative -mt-10 flex flex-1 items-start px-5 pb-20 sm:px-8 md:mt-0 md:min-h-[100svh] md:items-center md:pb-16 md:pt-16"
  >
    <div
      class="relative w-full max-w-[27rem] bg-crema/95 px-7 py-9 shadow-[0_24px_60px_-30px_rgba(46,66,87,0.45)] backdrop-blur-[2px] sm:px-10 sm:py-12 md:ml-[5vw]"
      data-hero-card
    >
      <p class="rotulo text-salvia" data-hero-item>Nos daría mucho gusto que vinieras al</p>

      <h1 class="mt-5" data-hero-item>
        <span class="titulo block text-[2.5rem] leading-[0.95] text-tinta sm:text-6xl">
          {evento.tipo}
        </span>
        {
          evento.bebe && (
            <span class="mt-3 block font-display text-[1.8rem] italic text-rosa sm:text-4xl">
              de {evento.bebe}
            </span>
          )
        }
      </h1>

      <div class="my-7 h-px w-16 bg-rosa/60" data-hero-item></div>

      <p
        class="max-w-lectura font-display text-lg leading-relaxed text-tinta/80 sm:text-xl"
        data-hero-item
      >
        {evento.frase}
      </p>

      <dl class="mt-8 space-y-4 text-sm" data-hero-item>
        <div>
          <dt class="rotulo text-salvia">Cuándo</dt>
          <dd class="mt-1.5 font-cuerpo font-light text-tinta">
            {evento.fechaTexto} · {evento.hora}
          </dd>
        </div>
        <div>
          <dt class="rotulo text-salvia">Dónde</dt>
          <dd class="mt-1.5 font-cuerpo font-light text-tinta">
            {evento.lugar} <span class="text-tinta/55">· {ciudad}</span>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <a
    href="#detalles"
    class="absolute bottom-5 left-1/2 hidden -translate-x-1/2 text-center text-tinta/45 transition hover:text-tinta md:block"
    data-hero-item
  >
    <span class="rotulo block">Ver detalles</span>
    <svg
      viewBox="0 0 24 24"
      class="mx-auto mt-2 h-4 w-4 animate-bounce"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
    >
      <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</header>
