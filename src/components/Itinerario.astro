---
import evento from '../data/evento.json';
import { ruta } from '../lib/rutas';
---

<section class="relative overflow-hidden bg-crema py-20 sm:py-28">
  <picture>
    <source type="image/webp" srcset={ruta('img/detalle-plato.webp')} />
    <img
      src={ruta('img/detalle-plato.jpg')}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="pointer-events-none absolute -right-12 bottom-12 hidden h-64 w-64 rounded-full object-cover opacity-95 shadow-[0_30px_70px_-50px_rgba(46,66,87,0.8)] lg:block"
    />
  </picture>

  <div class="relative mx-auto max-w-3xl px-5 sm:px-8">
    <p class="rotulo text-salvia" data-anim>Cómo va la tarde</p>
    <h2 class="titulo mt-4 text-3xl text-tinta sm:text-4xl" data-anim>Itinerario</h2>

    <ol class="mt-12 space-y-0">
      {
        evento.actividades.map((a, i) => (
          <li class="relative grid grid-cols-[5.5rem_1fr] gap-5 pb-9 sm:grid-cols-[7rem_1fr]" data-anim>
            {i < evento.actividades.length - 1 && (
              <span
                class="absolute left-[5.5rem] top-3 -ml-px h-full w-px bg-tinta/15 sm:left-[7rem]"
                aria-hidden="true"
              />
            )}
            <span class="pt-0.5 text-right font-cuerpo text-sm font-light tabular-nums text-tinta/60">
              {a.hora}
            </span>
            <div class="relative pl-6">
              <span
                class="absolute left-0 top-2 h-2 w-2 -translate-x-1/2 rounded-full bg-rosa"
                aria-hidden="true"
              />
              <p class="font-display text-2xl font-light text-tinta">{a.titulo}</p>
              {a.detalle && <p class="mt-1 text-sm font-light text-tinta/55">{a.detalle}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
