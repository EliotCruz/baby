---
import evento from "../data/evento.json";
---

<section class="bg-crema py-20 sm:py-28">
  <div
    class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-8 md:grid-cols-2 md:items-center md:gap-16"
  >
    <div>
      <p class="rotulo text-salvia" data-anim>Cómo llegar</p>
      <h2
        class="titulo mt-4 text-3xl leading-tight text-tinta sm:text-4xl"
        data-anim
      >
        {evento.lugar}
      </h2>
      <p
        class="mt-5 max-w-lectura text-base font-light leading-relaxed text-tinta/70"
        data-anim
      >
        {evento.direccion}
      </p>

      <div class="mt-9 flex flex-wrap gap-3" data-anim>
        <a
          href={evento.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="boton-solido"
        >
          Abrir en Google Maps
        </a>
        <a
          href={evento.wazeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="boton"
        >
          Waze
        </a>
      </div>
    </div>

    <!-- Mapa ilustrado: pesa 2 KB, funciona sin conexión y no rompe el estilo.
         Si prefieres un mapa real, aquí va el <iframe> de Google Maps. -->
